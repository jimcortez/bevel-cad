# $description
part: $name
rendering:
  name: $name

$name:
  text: "$text"
  font: DejaVu Sans        # any font name FreeType can find; DejaVu Sans covers most glyphs on Linux
  text_size: 10.0          # nominal em size (mm)
  text_depth: 0.8          # pocket depth (mm)
  text_raise: 0.4          # fill stands this far proud of the face (mm); compensates print shrinkage
  thickness: 2.0
  height: 25.0             # plate height (mm); width follows the text
  margin: 3.0
  chamfer: 0.8             # front perimeter chamfer (mm)
  corner_radius: 4.0
